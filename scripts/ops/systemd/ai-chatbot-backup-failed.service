[Unit]
Description=AI Chatbot backup failure notice

[Service]
Type=oneshot
Environment=ALERT_ENV_FILE=/root/AI-Chatbot/.env
ExecStart=/usr/bin/logger -p daemon.err -t ai-chatbot-backup "Daily PostgreSQL backup failed. Check: journalctl -u ai-chatbot-backup.service"
ExecStart=/usr/bin/env CHECK_NAME=postgres-backup CHECK_STATUS=FAIL "CHECK_HINT=Daily PostgreSQL backup failed. Check journalctl -u ai-chatbot-backup.service" /root/AI-Chatbot/scripts/ops/notify-production-health-failure.sh
