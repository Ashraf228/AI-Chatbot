{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NOLIS Demo Golden Question Dataset v1",
  "type": "object",
  "required": [
    "id",
    "datasetVersion",
    "title",
    "category",
    "severity",
    "language",
    "profile",
    "turns",
    "knowledgeSeedKeys",
    "expected",
    "tags"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^GQ-[0-9]{3}$" },
    "datasetVersion": { "const": "1.0.0" },
    "title": { "type": "string", "minLength": 3 },
    "category": {
      "enum": [
        "grounded_answer",
        "paraphrase",
        "source_grounding",
        "knowledge_gap",
        "clarification_resolution",
        "product_ticket_flow",
        "urgent_escalation",
        "redaction",
        "prompt_injection",
        "handoff_semantics"
      ]
    },
    "severity": { "enum": ["normal", "important", "hard"] },
    "language": { "const": "de" },
    "profile": { "const": "public-sector-product-support-demo" },
    "turns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["role", "text"],
        "properties": {
          "role": { "const": "user" },
          "text": { "type": "string", "minLength": 1 },
          "action": {
            "enum": [
              "confirm_ticket",
              "cancel_ticket",
              "request_handoff"
            ]
          },
          "repeatConfirm": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "knowledgeSeedKeys": {
      "type": "array",
      "items": { "type": "string" }
    },
    "expected": {
      "type": "object",
      "required": ["finalStatus"],
      "properties": {
        "finalStatus": { "type": "string" },
        "requiredSourceSeedKeys": { "type": "array", "items": { "type": "string" } },
        "forbiddenSourceSeedKeys": { "type": "array", "items": { "type": "string" } },
        "minimumSourceCount": { "type": "integer", "minimum": 0 },
        "maximumSourceCount": { "type": "integer", "minimum": 0 },
        "ticketCreated": { "type": "boolean" },
        "ticketCount": { "type": "integer", "minimum": 0 },
        "previewCreated": { "type": "boolean" },
        "confirmationRequired": { "type": "boolean" },
        "handoffRequested": { "type": "boolean" },
        "handoffStatus": { "type": "string" },
        "urgentEscalation": { "type": "boolean" },
        "requiredTicketFields": { "type": "object" },
        "forbiddenClaims": { "type": "array", "items": { "type": "string" } },
        "requiredPolicySignals": { "type": "array", "items": { "type": "string" } },
        "redactedMarkers": { "type": "array", "items": { "type": "string" } },
        "forbiddenRawValues": { "type": "array", "items": { "type": "string" } },
        "expectedAuditEvents": { "type": "array", "items": { "type": "string" } },
        "forbiddenAuditFields": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "tags": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
