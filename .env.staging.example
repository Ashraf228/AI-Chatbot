NODE_ENV=production
APP_ENV=staging
APP_VERSION=v0.9.0-production-candidate
APP_COMMIT_SHA=staging-local

STAGING_DASHBOARD_PORT=13000
STAGING_API_PORT=13001
STAGING_WIDGET_PORT=13002
STAGING_PROXY_HTTP_PORT=13080
STAGING_PROXY_HTTPS_PORT=13443

ADMIN_DOMAIN=staging-admin.localhost
API_DOMAIN=staging-api.localhost
WIDGET_DOMAIN=staging-widget.localhost
TLS_ENABLED=false
TLS_CERTS_DIR=./infra/nginx/certs
TLS_CERT_PATH=/etc/nginx/certs/fullchain.pem
TLS_KEY_PATH=/etc/nginx/certs/privkey.pem

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-staging-postgres-password
POSTGRES_DB=chatbot_staging
REDIS_PASSWORD=change-me-staging-redis-password

OPENAI_API_KEY=change-me-staging-openai-api-key
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

ADMIN_KEY=change-me-staging-admin-key-at-least-32-chars
DASHBOARD_INTERNAL_TOKEN=change-me-staging-dashboard-token-at-least-32-chars
ADMIN_PANEL_PASSWORD_HASH=change-me-staging-scrypt-password-hash
OPERATOR_PANEL_PASSWORD_HASH=
ADMIN_PANEL_PASSWORD=
ADMIN_SESSION_SECRET=change-me-staging-session-secret-at-least-32-chars
INTEGRATION_SECRET_KEY=change-me-staging-32-byte-base64-or-64-hex-secret
INTEGRATION_SECRET_KEY_PREVIOUS=
INTEGRATION_SECRET_LEGACY_KEYS=

BACKEND_BASE_URL=http://api:5000
PUBLIC_API_BASE_URL=http://localhost:13001
PUBLIC_WIDGET_BUNDLE_URL=http://localhost:13002/widget.js
NEXT_PUBLIC_WIDGET_LOADER_URL=http://localhost:13002/loader.js
REPORTER_API_BASE_URL=http://api:5000
APP_URL=http://localhost:13000
DASHBOARD_PUBLIC_URL=http://localhost:13000
API_PUBLIC_URL=http://localhost:13001
WIDGET_PUBLIC_URL=http://localhost:13002
CORS_ALLOWED_ORIGINS=http://localhost:13000
ALLOWED_ORIGINS=http://localhost:13000
SITE_DOMAIN_ALLOWLIST_MODE=strict

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
REPORTS_FROM_EMAIL=
LEAD_NOTIFICATION_EMAIL=
ADMIN_EMAIL=

# This file is a template only. Create /root/AI-Chatbot/.env.staging on the server
# with real staging values and keep it uncommitted.
