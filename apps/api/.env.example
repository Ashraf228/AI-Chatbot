NODE_ENV=development
APP_VERSION=local
PORT=5000

DATABASE_URL=postgres://postgres:postgres@localhost:5432/chatbot
REDIS_URL=redis://:redis_password@localhost:6379

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

ADMIN_KEY=replace_with_a_new_random_admin_key_at_least_32_chars
DASHBOARD_INTERNAL_TOKEN=replace_with_same_value_as_dashboard
INTEGRATION_SECRET_KEY=replace_with_32_byte_base64_or_64_character_hex_secret
INTEGRATION_SECRET_KEY_PREVIOUS=
INTEGRATION_SECRET_LEGACY_KEYS=

PUBLIC_API_BASE_URL=http://localhost:5000
PUBLIC_WIDGET_BUNDLE_URL=http://localhost:5173/widget.js
NEXT_PUBLIC_WIDGET_LOADER_URL=http://localhost:5173/loader.js
CORS_ALLOWED_ORIGINS=http://localhost:3000
SITE_DOMAIN_ALLOWLIST_MODE=relaxed

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
REPORTS_FROM_EMAIL=
LEAD_NOTIFICATION_EMAIL=alerts@example.com
ADMIN_EMAIL=admin@example.com
APP_URL=http://localhost:3000
