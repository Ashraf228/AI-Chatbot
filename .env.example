NODE_ENV=production
APP_VERSION=v0.9.0-production-candidate
APP_COMMIT_SHA=unknown

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

ADMIN_KEY=replace_with_a_new_random_admin_key_at_least_32_chars
ADMIN_SECRET=alias_documentation_only_use_ADMIN_KEY_in_compose
DASHBOARD_INTERNAL_TOKEN=replace_with_a_new_random_dashboard_token_at_least_32_chars
ADMIN_PANEL_PASSWORD=dev_only_replace_with_a_strong_local_password
ADMIN_PANEL_PASSWORD_HASH='scrypt$REPLACE_WITH_SALT_HEX$REPLACE_WITH_HASH_HEX'
OPERATOR_PANEL_PASSWORD_HASH='scrypt$REPLACE_WITH_OPTIONAL_OPERATOR_SALT_HEX$REPLACE_WITH_OPTIONAL_OPERATOR_HASH_HEX'
ADMIN_SESSION_SECRET=replace_with_a_new_random_session_secret_at_least_32_chars
SESSION_SECRET=alias_documentation_only_use_ADMIN_SESSION_SECRET_in_dashboard
INTEGRATION_SECRET_KEY=replace_with_32_byte_base64_or_64_character_hex_secret
INTEGRATION_SECRET_KEY_PREVIOUS=
INTEGRATION_SECRET_LEGACY_KEYS=
REDIS_PASSWORD=replace_with_a_new_random_redis_password
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_a_new_random_postgres_password
POSTGRES_DB=chatbot

DATABASE_URL=postgres://postgres:replace_with_a_new_random_postgres_password@localhost:5432/chatbot
REDIS_URL=redis://:replace_with_a_new_random_redis_password@localhost:6379
PORT=5000

BACKEND_BASE_URL=http://api:5000
PUBLIC_API_BASE_URL=https://api.example.com
PUBLIC_WIDGET_BUNDLE_URL=https://widget.example.com/widget.js
NEXT_PUBLIC_WIDGET_LOADER_URL=https://widget.example.com/loader.js
REPORTER_API_BASE_URL=http://api:5000
APP_URL=https://app.example.com
DASHBOARD_PUBLIC_URL=https://admin.example.com
API_PUBLIC_URL=https://api.example.com
WIDGET_PUBLIC_URL=https://widget.example.com
ADMIN_DOMAIN=admin.example.com
API_DOMAIN=api.example.com
WIDGET_DOMAIN=widget.example.com
CORS_ALLOWED_ORIGINS=https://admin.example.com
ALLOWED_ORIGINS=https://admin.example.com
TLS_ENABLED=false
TLS_CERTS_DIR=./infra/nginx/certs
TLS_CERT_PATH=/etc/nginx/certs/fullchain.pem
TLS_KEY_PATH=/etc/nginx/certs/privkey.pem

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
REPORTS_FROM_EMAIL=
LEAD_NOTIFICATION_EMAIL=alerts@example.com
ADMIN_EMAIL=admin@example.com

SITE_DOMAIN_ALLOWLIST_MODE=strict

# Rate limits are code-defined defaults today:
# widget chat/session/events: siteKey + IP fixed-window limits
# login: dashboard login limiter
# expensive admin actions: URL ingest and integration tests

# Billing plans are seeded by apps/api/migrations/017_billing_plans.sql.
# No Stripe keys are required in this production-candidate step.
